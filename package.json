{
  "name": "aday-atolyesi",
  "version": "0.23.2",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/prepare-workspace.mjs && node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "format": "prettier --write .",
    "cases": "python3 tools/build-cases.py && node scripts/prepare-workspace.mjs",
    "db:generate": "drizzle-kit generate",
    "demo": "node scripts/demo.mjs",
    "test": "node scripts/test.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.4.6",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.6",
    "json-rpc-2.0": "1.7.1",
    "prettier": "^3.9.10",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.2.9",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.1.7",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.5"
    },
    "sharp": "0.35.5",
    "source-map-js": "^1.2.2",
    "baseline-browser-mapping": "^2.11.0",
    "browserslist": "^4.28.7",
    "@babel/core": "^7.29.6",
    "image-size": "^2.0.3",
    "undici": "^7.30.1",
    "ws": "^8.21.0",
    "brace-expansion@<2": "^1.1.21",
    "js-yaml": "^4.3.0",
    "minimatch@>=7 <11": "^11.0.1",
    "esbuild": "^0.28.2",
    "satori": "^0.33.5",
    "fast-uri": "^3.1.9",
    "fflate": "^0.7.5"
  }
