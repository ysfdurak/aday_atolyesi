// Aday Atölyesi · Cloudflare Workers yayın ayarları (aday.ysfdurak.com canlı demosu).
// Gerçek bir pilot kurulumunda: AA_VITRIN "0" yapılır, kimlik doğrulayan bir ağ geçidi eklenir
// (docs/ARCHITECTURE.md → Yayına alma), "name", veritabanı ve kova adları değiştirilir.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aday-atolyesi",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  // Kimliksiz bağlamalar: ilk "wrangler deploy" veritabanını ve dosya kovasını kendisi oluşturur.
  // Tablolar ilk istekte kurulur (server/vitrin.mjs → ensureSchema, kaynak: drizzle/*.sql).
  "d1_databases": [{ "binding": "DB", "database_name": "aday-atolyesi-db" }],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "aday-atolyesi-dosyalar" }],
  "vars": {
    // 1 = herkese açık vitrin: rolle şifresiz giriş, ziyaretçiye özel alan, yalnız hazır örnek dosya,
    // her gece sıfırlama. Vitrinde yönetici ve değerlendirici hesapları her alan için ayrı kurulur;
    // PILOT_OWNER_EMAIL ve PROTECTED_MEMBERS yalnız gerçek pilot kurulumunda kullanılır.
    "AA_VITRIN": "1"
  },
  // Her gece 00:00 UTC (03:00 TSİ): vitrin verisini ve dosyaları sıfırla (worker/index.ts → scheduled).
  "triggers": { "crons": ["0 0 * * *"] },
  "observability": { "enabled": true },
  // PR önizlemeleri (Workers Builds → npx wrangler preview). Önizleme canlı ayarları devralmaz; canlı
  // veritabanına ve kovaya dokunmasın diye kendi veritabanı ve kovası vardır (ilk önizlemede oluşturulur).
  // Gece sıfırlama (cron) önizlemelerde yoktur; önizleme verisi kısa ömürlüdür.
  "previews": {
    "vars": { "AA_VITRIN": "1" },
    "d1_databases": [{ "binding": "DB", "database_name": "aday-atolyesi-onizleme-db" }],
    "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "aday-atolyesi-onizleme" }]
  }
}
